<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smc.signal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABS/PATH/smc-ftmo/.venv/bin/python</string>
    <string>-m</string>
    <string>smc_bot_signal</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABS/PATH/smc-ftmo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/smc-signal.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/smc-signal.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SMC_SIGNAL_DRY_RUN</key>
    <string>1</string>
    <key>SMC_SIGNAL_FEED_MODE</key>
    <string>memory</string>
  </dict>
</dict>
</plist>
