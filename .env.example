# TradingView alert URL: https://<tunnel>/webhooks/tradingview?token=<SMC_WEBHOOK_TOKEN>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SMC_WEBHOOK_TOKEN=replace-me-with-32-byte-random-secret

# SQLite path for alert_log / gate_ack / signal_events / execution_log
SMC_BOT_DB_PATH=output/bot.db

# Set to 1 only when running behind Cloudflare Tunnel (X-Forwarded-For trusted)
SMC_TRUSTED_PROXY=1

# Phase 02+ (not used in P0):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# DISCORD_WEBHOOK_URL=

# Phase 06+ (demo MT5, disabled by default):
# EXECUTOR_TRANSPORT=disabled
# MT5_OUTBOX_DIR=output/mt5_outbox